{
  "schema": "websvg/svg-types/0.1",
  "id": "WEBSVG_SVG_TYPES",
  "version": "0.1.0",
  "status": "draft",
  "purpose": "Canonical registry of WebSVG projection types. Document/demo manifests reference this registry and only declare which type each SVG document uses.",
  "invariants": [
    "projection_type describes rendering/topology behavior, not semantic authority",
    "SVG geometry remains representation authority",
    "semantic meaning is never inferred from projection type or geometry",
    "a document manifest MUST NOT redefine canonical projection types when a referenced registry provides them"
  ],
