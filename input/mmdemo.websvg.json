{
  "schema": "websvg/0.2",
  "document_set": "mmdemo",
  "title": "MMDemo WebSVG demo",
  "description": "SVG owns representation identities and local visual values. JSON owns semantic binding and relation rules.",
  "documents": [
    {
      "id": "mmdemo.process.timelines",
      "file": "mmdemo_process_timelines.svg",
      "type": "role-timelines"
    },
    {
      "id": "mmdemo.step-universal.matrix",
      "file": "mmdemo_step_universal_matrix.svg",
      "type": "step-universal-matrix"
    }
  ],
  "representation": {
    "identity_attribute": "data-websvg-id",
    "local_value_attributes": [
      "data-mode",
      "data-slot"
    ]
  },
  "bindings": [],
  "binding_rules": [
    {
      "kind": "role",
      "representation_prefixes": [
        "rep:timeline-role:",
        "rep:matrix-role:"
      ],
      "semantic_prefix": "role:"
    },
    {
      "kind": "step",
      "representation_prefixes": [
        "rep:timeline-step:",
        "rep:matrix-step:"
      ],
      "semantic_prefix": "step:"
    },
    {
      "kind": "universal",
      "representation_prefixes": [
        "rep:matrix-universal:"
      ],
      "semantic_prefix": "universal:"
    }
  ],
  "relation_rules": [
    {
      "type": "sequence",
      "representation_prefix": "rep:sequence:",
      "separator": ":",
      "from_semantic_prefix": "step:",
      "to_semantic_prefix": "step:"
    },
    {
      "type": "handoff",
      "representation_prefix": "rep:handoff:",
      "separator": ":",
      "from_semantic_prefix": "step:",
      "to_semantic_prefix": "step:"
    },
    {
      "type": "step_universal",
      "representation_prefix": "rep:matrix-cell:",
      "separator": ":",
      "from_semantic_prefix": "step:",
      "to_semantic_prefix": "universal:",
      "mode_attribute": "data-mode"
    }
  ],
  "relation_binding_rules": [
    {
      "relation_type": "sequence",
      "representation_template": "rep:sequence:{from}:{to}",
      "from_prefix": "step:",
      "to_prefix": "step:"
    },
    {
      "relation_type": "handoff",
      "representation_template": "rep:handoff:{from}:{to}",
      "from_prefix": "step:",
      "to_prefix": "step:"
    },
    {
      "relation_type": "step_universal",
      "representation_template": "rep:matrix-cell:{from}:{to}",
      "from_prefix": "step:",
      "to_prefix": "universal:"
    }
  ],
  "relations": []
}
