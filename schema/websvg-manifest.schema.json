{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebSVG Manifest",
  "type": "object",
  "required": [
    "schema",
    "document_set",
    "documents",
    "representation",
    "bindings",
    "relations"
  ],
  "properties": {
    "schema": {
      "const": "websvg/0.2"
    },
    "document_set": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "type": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "representation": {
      "type": "object",
      "required": ["identity_attribute"],
      "properties": {
        "identity_attribute": {
          "type": "string",
          "const": "data-websvg-id"
        },
        "local_value_attributes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["representation_ref"],
        "properties": {
          "representation_ref": { "type": "string", "minLength": 1 },
          "semantic_ref": { "type": "string", "minLength": 1 },
          "relation_ref": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          { "required": ["semantic_ref"] },
          { "required": ["relation_ref"] }
        ],
        "additionalProperties": true
      }
    },
    "relations": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/relation" }
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "$ref": "#/$defs/relation" }
          }
        }
      ]
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "required": ["id", "type", "from", "to"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "label": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
