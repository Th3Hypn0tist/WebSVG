{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigm.fi/schema/websvg-manifest.schema.json",
  "title": "WebSVG Manifest",
  "type": "object",
  "required": ["schema", "document_set", "documents", "semantics", "relations"],
  "properties": {
    "schema": {
      "const": "websvg/0.1"
    },
    "document_set": {
      "type": "string",
      "minLength": 1
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "src"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "src": { "type": "string", "minLength": 1 },
          "title": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "semantics": {
      "type": "object",
      "properties": {
        "identity_attribute": { "type": "string", "default": "data-semantic-id" },
        "kind_attribute": { "type": "string", "default": "data-kind" },
        "relation_from_attribute": { "type": "string", "default": "data-from" },
        "relation_to_attribute": { "type": "string", "default": "data-to" },
        "relation_type_attribute": { "type": "string", "default": "data-relation" },
        "relation_mode_attribute": { "type": "string", "default": "data-mode" }
      },
      "additionalProperties": true
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relation"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": { "type": "string", "minLength": 1 },
          "mode": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
